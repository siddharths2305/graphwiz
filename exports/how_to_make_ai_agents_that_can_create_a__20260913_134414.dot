digraph Workflow {
    rankdir=TB;
    graph [splines=ortho, nodesep=0.6, ranksep=0.9, pad=0.3];
    node [shape=box, style="rounded,filled", fillcolor="#EAF2FF", color="#3A6EA5", fontname="Arial", penwidth=1.2];
    edge [color="#3A6EA5", penwidth=1.4, arrowsize=0.8];
    start [label="Start", shape=circle, fillcolor="#E8F5E9", color="#2E7D32"];
    end [label="End", shape=circle, fillcolor="#FDECEA", color="#C62828"];
    n0 [label="→ produces my_workflow.png (and my_workflow.dot)", fillcolor="#FFF8E1"];
    n1 [label="1. High‑level Architecture", fillcolor="#E3F2FD"];
    n2 [label="**Parsing Agent** – a small program (or an LLM‑prompt) that reads the...", fillcolor="#FFF8E1"];
    n3 [label="**Graphviz Engine** – the `graphviz` Python package (or the CLI) that...", fillcolor="#E3F2FD"];
    n4 [label="2. Choose Your Toolchain", fillcolor="#FFF8E1"];
    n5 [label="3. Define a Simple Markdown DSL (Domain‑Specific Language)", fillcolor="#E3F2FD"];
    n6 [label="4. Minimal Working Prototype (Python)", fillcolor="#FFF8E1"];
    n7 [label="Reads a `.md` file.", fillcolor="#E3F2FD"];
    n8 [label="Extracts nodes and edges using the DSL above.", fillcolor="#FFF8E1"];
    n9 [label="Generates a Graphviz diagram (`workflow.png`).", fillcolor="#E3F2FD"];
    n10 [label="How to run it", fillcolor="#FFF8E1"];
    n11 [label="5. Turning the Script into an **AI Agent**", fillcolor="#E3F2FD"];
    n12 [label="5.1 Prompt Template (for GPT‑4/Claude)", fillcolor="#FFF8E1"];
    n13 [label="5.2 Python glue code (using `openai` library)", fillcolor="#E3F2FD"];
    n14 [label="6. Extending the Agent (Optional Enhancements)", fillcolor="#FFF8E1"];
    n15 [label="7. Summary Checklist", fillcolor="#E3F2FD"];
    start -> n0;
    n0 -> n1;
    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> n5;
    n5 -> n6;
    n6 -> n7;
    n7 -> n8;
    n8 -> n9;
    n9 -> n10;
    n10 -> n11;
    n11 -> n12;
    n12 -> n13;
    n13 -> n14;
    n14 -> n15;
    n15 -> end;
}
